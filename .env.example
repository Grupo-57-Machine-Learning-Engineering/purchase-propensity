# Copie para .env e ajuste se precisar: cp .env.example .env
# O .env não é versionado. Sem ele, valem os mesmos padrões abaixo, e o MLflow grava
# localmente em vez de enviar ao DAGsHub.

# Dataset no Kaggle (dono/dataset/versions/N). A versão fixa garante o mesmo dado.
DATASET_HANDLE=benpowis/customer-propensity-to-purchase-data/versions/3

# Pasta de dados (raw/ e processed/). Caminho relativo parte da raiz do projeto.
DATA_DIR=data

# Nível de log do pipeline: DEBUG, INFO, WARNING ou ERROR.
LOG_LEVEL=INFO

# MLflow no DAGsHub. Usuário e token são os seus (dagshub.com/user/settings/tokens),
# com acesso de colaborador ao repositório. Sem URI, o MLflow grava em ./mlflow.db.
MLFLOW_TRACKING_URI=https://dagshub.com/ThiagoZulian/purchase-propensity.mlflow
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
