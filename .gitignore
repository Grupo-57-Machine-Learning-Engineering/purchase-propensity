# --- Dados e artefatos (versionados pelo DVC, não pelo git) -----------------
# data/raw não entra aqui: o `dvc add` cria data/raw/.gitignore para cada arquivo
# rastreado. Ignorar a pasta toda faz o DVC pular o .dvc dela, e o `dvc pull`
# deixa de baixar o dataset.
data/processed/*
!data/processed/.gitkeep
models/*
!models/.gitkeep
mlruns/
mlartifacts/
mlflow.db

# --- Segredos ----------------------------------------------------------------
.env

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/

# --- Ambientes virtuais ------------------------------------------------------
.venv/
venv/
env/

# --- Ferramentas / caches ----------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
coverage.xml

# --- Notebooks ---------------------------------------------------------------
.ipynb_checkpoints/

# --- IDE / SO -----------------------------------------------------------------
.DS_Store
.idea/
.vscode/
